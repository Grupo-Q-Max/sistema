generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ========================
// 1. ENUMS (Domínios de Dados)
// ========================

enum Role {
  ADMIN
  FISCAL
  DP
  SOCIO
  CONTABIL
  FINANCEIRO
  CADASTRO
  CUSHMAN
}

enum TaxRegime {
  MEI
  SIMPLES_NACIONAL
  SIMPLES_NACIONAL_HIBRIDO
  LUCRO_PRESUMIDO
  LUCRO_REAL_TRIMESTRAL
  LUCRO_REAL_ESTIMATIVA
  LUCRO_REAL_ANUAL
  IMUNE_IRPJ
  CONDOMINIOS
  DOMESTICA
  ASSOCIACOES
  PESSOA_FISICA
}

enum ClosingType {
  FISCAL
  DP
  CUSHMAN
  CONTABIL
  PARCELAMENTO
}

enum ClosingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  NOT_APPLICABLE
}

enum SectorAccess {
  NONE
  VIEW
  EDIT
}

enum CompanyAccessScope {
  ALL
  RESPONSIBLE
  CUSTOM
}

// ========================
// 2. TABELAS CORE
// ========================

model User {
  id       String  @id @default(uuid())
  name     String?
  email    String  @unique
  password String
  role     Role    @default(CADASTRO)
  active   Boolean @default(true)

  // Desligamento do usuário (não faz mais parte da empresa)
  leftAt     DateTime?
  exitReason String?

  // Escopo de visualização de empresas: ALL (todas), RESPONSIBLE (onde é o responsável), CUSTOM (seleção manual)
  companyScope CompanyAccessScope @default(ALL)

  // Mantido para compatibilidade booleana
  canViewAllCompanies Boolean @default(true)
  editOnlyResponsible Boolean @default(false)

  createdById String?

  sectorPermissions      UserSectorPermission[]
  screenPermissions      UserScreenPermission[]
  companyAccess          UserCompanyAccess[]
  responsibleAssignments CompanyResponsible[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================
// PERMISSÕES (configuráveis pelo Admin/Sócio na tela de Configurações)
// ========================

// Nível de acesso de um usuário a cada setor (NONE / VIEW / EDIT)
model UserSectorPermission {
  id     String       @id @default(uuid())
  userId String
  sector ClosingType
  access SectorAccess @default(NONE)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sector])
}

// Telas que o usuário pode abrir (chaves definidas em src/shared/permissions.ts)
model UserScreenPermission {
  id      String  @id @default(uuid())
  userId  String
  screen  String
  allowed Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, screen])
}

// Empresas específicas liberadas manualmente (usado quando companyScope = CUSTOM)
model UserCompanyAccess {
  userId    String
  companyId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
}

// Vínculo de funcionário responsável pela empresa (por setor ou geral)
model CompanyResponsible {
  id        String       @id @default(uuid())
  companyId String
  userId    String
  sector    ClosingType? // Opcional: responsável no Fiscal, no DP, etc.

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId, sector])
  @@index([sector])
  @@index([userId, sector])
}

model Company {
  id                    String    @id @default(uuid())
  code                  String? // Código da empresa (letras e números)
  name                  String // Razão Social
  tradeName             String? // Nome Fantasia
  cnpj                  String    @unique
  taxRegime             TaxRegime
  groupName             String? // Grupo econômico
  stateRegistration     String? // Inscrição Estadual
  municipalRegistration String? // Inscrição Municipal
  city                  String? // Município

  // Datas de controle de ciclo de vida (Crucial para a lógica de aparecer ou não)
  contractDate            DateTime?
  obligationStartDate     DateTime?
  exitDate                DateTime? // Nulo significa que ainda é cliente ativa
  exitMonthHasObligations Boolean   @default(false)
  targetProxyIssueDate     DateTime? // Procuração Receita / Target (Emissão)
  targetProxyDate          DateTime? // Procuração Receita / Target (Vencimento)
  fgtsProxyIssueDate       DateTime? // Procuração FGTS (Emissão)
  fgtsProxyDate            DateTime? // Procuração FGTS (Vencimento)
  decProxyIssueDate        DateTime? // Procuração DEC (Emissão)
  decProxyDate             DateTime? // Procuração DEC (Vencimento)
  empregadorProxyIssueDate DateTime? // Procuração Empregador Web (Emissão)
  empregadorProxyDate      DateTime? // Procuração Empregador Web (Vencimento)

  // Certificado Cliente
  hasClientCertificate  Boolean @default(false)
  certificateType       String? // A1, A3 CARTÃO, A3 TOKEN
  certificatePassword   String? @db.Text // Criptografado no banco
  certificateIssue      String? // Mês/Ano (MM/AAAA)
  certificateExpiration String? // Mês/Ano (MM/AAAA)

  // Classificações e configurações
  companyType    String? // Comércio, Holding, Igreja, Indústria, Serv/Com, Serviço, Transporte
  deliveryMethod String? // E-mail, Nibo, Nibo/WhatsApp, Nibo/E-mail, Nibo/Onvio
  activeSectors  String? // "FISCAL,DP,CONTABIL,CUSHMAN" ou "TODOS"

  // Logins e acessos municipais e sistemas
  cityHallLogin      String? // Login Prefeitura
  cityHallLink       String? // Link Prefeitura
  ginfessPassword    String? @db.Text // Senha Ginfess (Criptografada)
  gissOnlinePassword String? @db.Text // Senha Giss Online (Criptografada)
  sdLogin            String? // SD Login (Seguro Desemprego / Empregador Web)
  sdPassword         String? @db.Text // SD Senha (Criptografada)
  nfAccessType       String? // Tipo de Acesso NF (ex: Senha GOV, Senha Própria, Certificado A1)
  nfLogin            String? // Login Nota Fiscal Contribuinte
  nfPassword         String? @db.Text // Senha Nota Fiscal Contribuinte (Criptografada)

  // Dissídio e Observações
  dissidioMonthYear String? // MM/AAAA
  notes             String? @db.Text
  notesScope        String? @default("GERAL") // GERAL, FISCAL, DP, CONTABIL, CUSHMAN

  legacyData Json? // Origem e pendências da importação, sem inventar datas

  // Relacionamentos
  installmentPlans InstallmentPlan[]
  closings         Closing[]
  userAccess       UserCompanyAccess[]
  responsibles     CompanyResponsible[]
  automationTasks  AutomationTask[]
  dominioStagingChanges DominioStagingChange[]

  @@index([obligationStartDate, exitDate])
  @@index([code])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
}

// ========================
// 3. CONFIGURADOR DE COLUNAS (O motor dinâmico)
// ========================
// Define as "Colunas" que vão aparecer no fechamento de cada setor (Sem sujar o DB principal)

model DepartmentColumn {
  isActive         Boolean     @default(true) // Permite ocultar colunas sem apagar dados
  fieldConfig      Json? // Opções e descrição de campos digitáveis/listas
  visibilityConfig Json? // Meses e anos em que a coluna aparece; null = todas as competências
  columnKey        String? // Chave estável do popup, preservada ao renomear
  popupConfig      Json? // Campos, botões e regras; null usa o modelo original
  id               String      @id @default(uuid())
  department       ClosingType // A qual aba essa coluna pertence (ex: DP)

  name           String // Nome da coluna (ex: "Calcular Folha")
  inputType      String // Tipo (ex: "TEXT", "CHECKBOX", "POPUP")
  replicates     Boolean @default(false) // Se o dado copia pro mês seguinte automaticamente
  countsProgress Boolean @default(false) // Se a conclusão desta coluna conta para a barra de progresso do fechamento
  isEditable     Boolean @default(true) // Editável ou apenas visualização
  orderIndex     Int     @default(0) // Ordem que aparece na tela

  @@index([department, orderIndex])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================
// 3. TABELA DE FECHAMENTOS (Evitando poluição)
// ========================
// Em vez de criarmos 200 colunas (uma para cada tarefa/obrigação), usamos
// uma estrutura vertical + JSON, que suporta infinitas "colunas do Excel" 
// sem sujar a estrutura do banco de dados relacional.

model Closing {
  id        String      @id @default(uuid())
  companyId String
  type      ClosingType // Define se é da aba Fiscal, DP, Contábil, etc

  // Mês e Ano de referência (Para contábil pode ser apenas o ano, ex: 2026-01-01)
  referencePeriod DateTime

  status ClosingStatus @default(PENDING)

  // Métricas extraídas que precisamos pro Dashboard (evita ter que ler o JSON)
  // Ex: No DP, salva a quantidade de vidas. No Fiscal, pode salvar o Faturamento.
  dashboardMetrics Json?

  // Aqui entram as "Várias e Várias colunas". Salvaremos como JSON para não
  // engessar o banco. Se amanhã criar uma coluna nova, não precisa mexer no BD.
  // Ex: { "imposto_renda_entregue": true, "folha_calculada": false }
  columnsData Json?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  automationTasks AutomationTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Garante que não tenhamos dois fechamentos de DP para a mesma empresa no mesmo mês
  @@unique([companyId, type, referencePeriod])
  @@index([type, referencePeriod])
  @@index([referencePeriod])
}

// Parcelamentos são cadastros permanentes, com confirmações mensais próprias.
model InstallmentType {
  id        String   @id @default(uuid())
  name      String
  nameKey   String   @unique
  createdAt DateTime @default(now())
}

model InstallmentPlan {
  id               String               @id @default(uuid())
  companyId        String
  typeName         String
  totalAmount      Decimal              @db.Decimal(14, 2)
  status           String               @default("ATIVO")
  installmentCount Int
  startsAt         DateTime             @db.Date
  endsAt           DateTime             @db.Date
  responsibleId    String?
  lateMode         String?
  lateMonthOffset  Int?
  dueDay           Int?
  dueMonthOffset   Int?
  notes            String?              @db.Text
  createdById      String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  company          Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  payments         InstallmentPayment[]
  events           InstallmentEvent[]

  @@index([companyId])
}

model InstallmentPayment {
  id                String          @id @default(uuid())
  planId            String
  installmentNumber Int
  status            String          @default("PENDING")
  paidOn            DateTime?       @db.Date
  paidAmount        Decimal?        @db.Decimal(14, 2)
  note              String?         @db.Text
  updatedById       String?
  updatedAt         DateTime        @updatedAt
  plan              InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@unique([planId, installmentNumber])
}

model InstallmentEvent {
  id                String          @id @default(uuid())
  planId            String
  installmentNumber Int?
  action            String
  actorId           String
  data              Json
  createdAt         DateTime        @default(now())
  plan              InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId, createdAt])
}

model InstallmentSetting {
  id              String   @id
  lateMode        String   @default("MONTH_TURN")
  lateMonthOffset Int      @default(2)
  dueDay          Int      @default(20)
  dueMonthOffset  Int      @default(1)
  closingLinkMode String   @default("DUE_NEXT_MONTH")
  updatedAt       DateTime @updatedAt
}

model SystemLog {
  id        String   @id @default(uuid())
  userId    String?
  userEmail String?
  userName  String?
  action    String
  entity    String?
  entityId  String?
  details   Json?
  ipAddress String?

  @@index([createdAt])
  @@index([action, createdAt])
  createdAt DateTime @default(now())
}

// ========================
// 4. AUTOMAÇÃO E ROBÔS (RPA)
// ========================

enum TaskStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model AutomationTask {
  id              String      @id @default(uuid())
  taskType        String      // Ex: "DOWNLOAD_DAS", "EXTRACT_SPED"
  status          TaskStatus  @default(PENDING)
  companyId       String?     // Opcional, se a tarefa for relacionada a uma empresa
  closingId       String?     // Opcional, vincula diretamente a um fechamento
  referencePeriod DateTime?   // Competência
  
  payload         Json?       // Dados de entrada para o robô (ex: CNPJ, qual imposto)
  result          Json?       // Resposta do robô (ex: url do pdf salvo, mensagem de erro)
  
  errorMessage    String?     @db.Text
  attempts        Int         @default(0)
  maxAttempts     Int         @default(3)
  
  startedAt       DateTime?
  completedAt     DateTime?
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  company         Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  closing         Closing?    @relation(fields: [closingId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}


model AppConfig {
  id        String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ========================
// 5. CONCILIAÇÃO E APROVAÇÃO DOMÍNIO (STAGING)
// ========================

enum DominioApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model DominioStagingChange {
  id              String                @id @default(uuid())
  companyId       String?
  companyCode     String?               // Código Domínio (ex: "5", "102")
  companyName     String                // Razão Social
  sector          String                // "CONTABIL", "FISCAL", "DP"
  referencePeriod String                // "10/2026", "2026-10", "2026"
  columnKey       String                // Ex: "fechamento_doc", "cobranca_doc", "das", etc.
  columnLabel     String                // Ex: "Fechamento Documentos", "Cobrança Doc"
  currentValue    String?               // Valor atual no Fechamento Pro
  proposedValue   String                // Novo valor identificado no Domínio
  status          DominioApprovalStatus @default(PENDING)
  sourceFile      String?               // Nome do backup de origem (ex: "50110_20261104_1000M.dom")
  approvedBy      String?               // Nome ou email do usuário que aprovou
  approvedAt      DateTime?
  rejectedAt      DateTime?

  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  company         Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([status, sector])
  @@index([companyCode, referencePeriod])
}

// ========================
// 12. SNAPSHOT / CONGELAMENTO DE COMPETENCIA
// ========================

model CompetenceSnapshot {
  id              String    @id @default(uuid())
  referencePeriod DateTime
  sector          String
  snapshotData    String    @db.LongText
  summary         String?   @db.LongText
  closedByUserId  String?
  closedByName    String?
  createdAt       DateTime  @default(now())

  @@index([referencePeriod, sector])
}
